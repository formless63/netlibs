{
  "name": "@formless63/viewer-ecad",
  "version": "0.1.0",
  "description": "KiCad and Gerber/Excellon viewers.",
  "keywords": [
    "react",
    "kicad",
    "gerber",
    "pcb",
    "viewer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formless63/netlibs.git",
    "directory": "packages/viewer-ecad"
  },
  "homepage": "https://github.com/formless63/netlibs/tree/main/packages/viewer-ecad#readme",
  "bugs": {
    "url": "https://github.com/formless63/netlibs/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./vendor/kicanvas.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "vendor",
    "LICENSE"
  ],
