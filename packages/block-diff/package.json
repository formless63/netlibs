{
  "name": "@formless63/block-diff",
  "version": "0.1.0",
  "private": true,
  "description": "Compare two revisions of a block document by stable block identity, with move detection.",
  "keywords": [
    "diff",
    "prosemirror",
    "tiptap",
    "revision",
    "blocks"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prosemirror": {
      "types": "./dist/prosemirror.d.ts",
      "default": "./dist/prosemirror.js"
    },
    "./package.json": "./package.json"
  }
}
