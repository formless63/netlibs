{
  "name": "@formless63/editor-react",
  "version": "0.1.1",
  "description": "A Tiptap-based rich-text editor component with media viewers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formless63/netlibs.git",
    "directory": "packages/editor-react"
  },
  "homepage": "https://github.com/formless63/netlibs/tree/main/packages/editor-react#readme",
  "bugs": {
    "url": "https://github.com/formless63/netlibs/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./viewers": {
      "types": "./dist/viewers/index.d.ts",
      "default": "./dist/viewers/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@formless63/editor-core": "workspace:*",
    "@formless63/editor-renderer": "workspace:*",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@floating-ui/dom": "1.8.0",
    "@lezer/highlight": "1.2.5",
    "@tabler/icons-react": "3.52.0",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-bubble-menu": "3.35.0",
    "@tiptap/extension-emoji": "3.35.0",
    "@tiptap/extension-file-handler": "3.35.0",
    "@tiptap/extension-invisible-characters": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/suggestion": "3.35.0",
    "katex": "0.18.11",
    "radix-ui": "1.8.1"
  },
  "peerDependencies": {
    "mermaid": "^12.0.0",
    "pdfjs-dist": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
