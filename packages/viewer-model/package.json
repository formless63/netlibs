{
  "name": "@formless63/viewer-model",
  "version": "0.1.0",
  "description": "3D model viewers: meshes via online-3d-viewer, GLB/glTF via model-viewer.",
  "keywords": [
    "react",
    "3d",
    "stl",
    "glb",
    "gltf",
    "viewer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formless63/netlibs.git",
    "directory": "packages/viewer-model"
  },
  "homepage": "https://github.com/formless63/netlibs/tree/main/packages/viewer-model#readme",
  "bugs": {
    "url": "https://github.com/formless63/netlibs/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./definitions": {
      "types": "./dist/definitions.d.ts",
      "import": "./dist/definitions.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@formless63/viewer-core": "workspace:*",
    "@google/model-viewer": "4.4.0",
    "online-3d-viewer": "0.18.0",
    "three": "0.187.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
